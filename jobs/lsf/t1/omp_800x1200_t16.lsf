#BSUB -J omp_800x1200_t16
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(16)]"
#BSUB -o results/polus/s2/omp_800x1200_t16.%J.out
#BSUB -e results/polus/s2/omp_800x1200_t16.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (omp_800x1200_t16) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
export OMP_NUM_THREADS=16 OMP_PROC_BIND=close
/polusfs/lsf/openmp/launchOpenMP.py ./poisson_omp 800 1200
date
