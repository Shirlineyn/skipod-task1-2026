#BSUB -J omp_800x1200_t4
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(4)]"
#BSUB -o results/polus/s4/omp_800x1200_t4.%J.out
#BSUB -e results/polus/s4/omp_800x1200_t4.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
#BSUB -x
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (omp_800x1200_t4) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
export OMP_NUM_THREADS=4 OMP_PROC_BIND=close
/polusfs/lsf/openmp/launchOpenMP.py ./poisson_omp 800 1200
date
