#BSUB -J mpi_800x1200_p32
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 32
#BSUB -R "affinity[core(1)] span[ptile=16]"
#BSUB -o results/polus/s4/mpi_800x1200_p32.%J.out
#BSUB -e results/polus/s4/mpi_800x1200_p32.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
#BSUB -x
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (mpi_800x1200_p32) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
mpiexec ./poisson_mpi 800 1200
date
