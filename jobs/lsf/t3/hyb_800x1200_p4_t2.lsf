#BSUB -J hyb_800x1200_p4_t2
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 4
#BSUB -R "affinity[core(2)] span[hosts=1]"
#BSUB -o results/polus/hyb_800x1200_p4_t2.%J.out
#BSUB -e results/polus/hyb_800x1200_p4_t2.%J.err
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (hyb_800x1200_p4_t2) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
export OMP_NUM_THREADS=2
mpiexec -x OMP_NUM_THREADS ./poisson_hyb 800 1200
date
