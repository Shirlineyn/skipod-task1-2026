#BSUB -J seq_80x80
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(1)]"
#BSUB -o results/polus/s2/seq_80x80.%J.out
#BSUB -e results/polus/s2/seq_80x80.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (seq_80x80) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
./poisson_seq 80 80 --out results/polus/s2/sol_80x80.bin
date
