#BSUB -J mpi_80x80_p2
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 2
#BSUB -R "affinity[core(1)] span[hosts=1]"
#BSUB -o results/polus/mpi_80x80_p2.%J.out
