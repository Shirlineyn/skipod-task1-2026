#BSUB -J hyb_80x80_p1_t4
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(4)] span[hosts=1]"
#BSUB -o results/polus/hyb_80x80_p1_t4.%J.out
#BSUB -e results/polus/hyb_80x80_p1_t4.%J.err
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (hyb_80x80_p1_t4) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
export OMP_NUM_THREADS=4
mpiexec -x OMP_NUM_THREADS ./poisson_hyb 80 80
date
