#BSUB -J seq_40x40
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(1)]"
#BSUB -o results/polus/s2/seq_40x40.%J.out
#BSUB -e results/polus/s2/seq_40x40.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (seq_40x40) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
./poisson_seq 40 40 --out results/polus/s2/sol_40x40.bin
date
