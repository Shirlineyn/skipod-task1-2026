#BSUB -J seq_800x1200
#BSUB -q short
#BSUB -W 00:10
#BSUB -n 1
#BSUB -R "affinity[core(1)]"
#BSUB -o results/polus/s3/seq_800x1200.%J.out
#BSUB -e results/polus/s3/seq_800x1200.%J.err
#BSUB -m "polus-c3-ib polus-c4-ib"
#BSUB -x
source /polusfs/setenv/setup.SMPI
echo "job $LSB_JOBID (seq_800x1200) hosts: $LSB_HOSTS"
echo "bind cpu list: ${LSB_BIND_CPU_LIST:-none}"
date
./poisson_seq 800 1200 --out results/polus/s3/sol_800x1200.bin
date
